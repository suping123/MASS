# ============================================================================
# 供应链多智能体调度与异常处理系统 · 配置样例
# 复制为 .env 后按需要修改即可（所有项均可调，无需改代码）。
# 变量前缀统一为 SCA_；pydantic_settings 或内置回退都会自动加载本文件。
# ============================================================================

# ===== 模型（在线 API，阿里云百炼 / DashScope，OpenAI 兼容协议） =====
SCA_DASHSCOPE_API_KEY=sk-your-key-here
SCA_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SCA_INTENT_MODEL=tongyi-intent-detect-v3      # 意图识别 + 工具路由（FR-12）
SCA_REASON_MODEL=qwen-plus                    # 复杂推理（Qwen 在线 API）
SCA_EMBEDDING_MODEL=text-embedding-v3         # 知识库向量（接 PG+pgvector 后启用）
SCA_INTENT_TIMEOUT=5.0                        # 意图模型调用超时（秒），可调高避免弱网卡顿

# ===== 存储 =====
# 不装 PostgreSQL 时 SCA_USE_PG=false，检查点自动回退到内存（MemorySaver），骨架可直接跑通
SCA_USE_PG=false
SCA_PG_DSN=postgresql://sca:sca@localhost:5432/sca

# ===== 长短期记忆（sca.memory；依赖 SCA_USE_PG=true 作持久层） =====
# 写入异步：op 先写穿透 Redis（请求内完成，保证会话内读个人写）并 append WAL stream，
# worker 再 fold 进 PG；Redis 不可达自动降级 pg_direct（同步落 PG，正确性不变）。
SCA_MEMORY_ENABLED=true
SCA_USE_REDIS=true                           # false 可强制 PG-only（不碰 Redis）
SCA_REDIS_URL=redis://127.0.0.1:6379/0       # Redis 7.2 验证
SCA_MEMORY_WAL_STREAM=mem:wal                # WAL stream 键名
SCA_MEMORY_WAL_GROUP=memfold                 # fold worker 消费组
SCA_MEMORY_PINNED_KEYS=profile.display_name,preference.notify_channel   # 固定块，上下文裁剪时永不淘汰
SCA_MEMORY_CONTEXT_BUDGET=1024               # 每轮记忆注入的近似 token 预算

# ===== 仿真（原型期只做模拟论证，见可行性报告 v2 §3.5） =====
SCA_SIM_FIDELITY=F1                           # F1 全合成 / F2 回放增强 / F3 影子模式
SCA_BASELINE_AUTO_SUCCESS_RATE=0.0            # =0 用 baseline.py 默认；>0 覆盖"自动处置成功率"假设

# ===== Web 服务（启动相关，均可调） =====
SCA_HOST=0.0.0.0                              # 监听地址（本机访问用 127.0.0.1）
SCA_PORT=8000                                 # 监听端口（uvicorn --port 可覆盖）
SCA_LOG_LEVEL=info                            # debug/info/warning
SCA_API_PREFIX=/api                           # 所有 JSON 接口统一前缀（前后端分离 + 网关路由）
SCA_FRONTEND_DIR=                             # 前端静态目录；留空则取 <项目根>/frontend
SCA_CORS_ORIGINS=*                            # 允许跨域来源，逗号分隔；* 为全部（前后端分离开发用）

# ===== 工具层（MCP）真实数据源开关：留空用内置实现，填了就走真实服务 =====
# 不填时：map-mcp 用内置真实路网（45 城经纬度 + haversine×1.25）、capacity-mcp 用内置运力池
SCA_AMAP_KEY=                                 # 高德 Key（Web 服务）：填了则 map-mcp 走真实路径规划 + weather-mcp 走高德官方预报（一个 Key 管两件事）
SCA_CAPACITY_API=                             # 真实运力平台 URL（返回承运商 JSON 数组）：填了则替换内置运力池
SCA_MCP_HTTP_BASE=                            # MCP HTTP 网关基址：填了则工具调用走 HTTP 而非进程内直连

# ===== 钉钉通知（可选；不配时已用免账号真实通道：本机 Windows 桌面弹窗 + 审计日志）=====
# 获取：钉钉群 -> 群设置 -> 智能群助手 -> 添加"自定义"机器人 -> 安全设置选"加签"
# 复制 Webhook 与加签 Secret 填到下面两行（建议用测试群）
SCA_DINGTALK_WEBHOOK=                         # 形如 https://oapi.dingtalk.com/robot/send?access_token=xxxx
SCA_DINGTALK_SECRET=                          # 形如 SECxxxxxxxx
SCA_NOTIFY_DESKTOP=true                       # 免账号桌面弹窗通知（false 关闭）；审计日志 data/notifications.jsonl 始终落盘

# ===== 和风天气（可选；不配时已用免 Key 真实气象 Open-Meteo：真实预报 + 阈值推导预警）=====
SCA_QWEATHER_KEY=                             # 和风 API Key（配了升级为官方预报/官方预警）
SCA_QWEATHER_HOST=                            # 专属 API Host（新版账号控制台可见，形如 abcxyz.re.qweatherapi.com）；留空自动探测公共域名

# ===== 流程开关 =====
SCA_HITL_ENABLED=true                         # true=P0/P1 挂起等人工审批；false=自动审批通过（演示/压测）

# ===== 常驻 Agent（S4/S5）：四进程 start_agents.bat =====
# 每个 agent 一个 OS 进程、一份日志（logs/agent_<kind>.log）。
# **S5 起它们是必需的**：下单/挂牌/投标/接单都由 agent 消费消息后执行，
# 进程不在时这些接口返回 504。到期裁决与协商推进也只在这里跑。
SCA_AGENT_WAKE=1                              # 1=Redis 门铃（有消息立刻醒）；0=纯轮询，慢一个 poll 周期
SCA_AGENT_LOG=INFO                            # agent 进程日志级别
SCA_AGENT_WAIT_S=5                            # HTTP 等 agent 回复的上限（秒）。超时返回 504
SCA_AGENT_STALE_S=120                         # 委托超过这么久才被消费就不执行了（人早已超时，可能在重做）
# SCA_CARRIER_AUTOBID=1                       # 1=承运商看到开放招标就自己算价投标（默认关，见 README 能力边界）
# SCA_WEATHER_WATCH=1                         # 1=异常域每 20s 扫一次在途天气（默认关，会打真实天气 API）
